* text=auto eol=lf

# Captured example bytes are bound by receipts and browser hashes.
examples/** -text

# Windows double-click entry must retain CRLF on checkout and archive.
Start-Demo.cmd text eol=crlf

# Preserve CRLF bytes in git clones and automatic source archives.
Start-Demo.cmd -text eol=crlf whitespace=cr-at-eol
